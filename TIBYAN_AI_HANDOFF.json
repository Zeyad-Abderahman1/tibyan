  "databaseArchitecture": {
    "systemDb": {
      "canonicalPath": "%APPDATA%\\Tibyan\\data\\system\\tibyan-system.sqlite",
      "tables": [
        "users",
        "permissions",
        "user_permissions",
        "academic_years",
        "global_settings",
        "system_audit_log",
        "backup_records"
      ],
      "persistence": "Persistent across all academic years; never recreated or unmounted on year switch."
    },
    "academicDb": {
      "canonicalPathTemplate": "%APPDATA%\\Tibyan\\data\\academic-years\\tibyan-<YYYY-YYYY>.sqlite",
      "tables": [
        "students",
        "student_notes",
        "groups",
        "group_enrollments",
        "group_schedules",
        "sessions",
        "academic_audit_log"
      ],
      "persistence": "Scoped strictly to one academic year; unmounted when switching years."
    },
    "crossDatabaseForeignKeys": false,
    "authoritativeFilenameInRegistry": true,
    "neverSynthesizeDbFilenameFromId": true,
    "singleActiveMountedYear": true,
    "triggers": {
      "systemAuditNoUpdate": "trg_system_audit_no_update",
      "systemAuditNoDelete": "trg_system_audit_no_delete",
      "academicAuditNoUpdate": "trg_academic_audit_no_update",
      "academicAuditNoDelete": "trg_academic_audit_no_delete"
    }
  },
  "securityRules": {
    "contextIsolation": true,
    "nodeIntegration": false,
    "sandbox": true,
    "webSecurity": true,
    "allowRunningInsecureContent": false,
    "webviewTag": false,
    "rawIpcRendererExposed": false,
    "genericInvokeChannelAllowed": false,
    "rendererDirectDbAccessAllowed": false,
    "rendererDirectFilesystemAccessAllowed": false,
    "authoritativeSessionProcess": "MAIN",
    "rendererSessionTrustedForAuthorization": false,
    "ipcBoundaryValidation": "Zod schemas",
    "safeErrorHandling": "safeIpcCall with mapErrorToIpcResult (INTERNAL_ERROR fallback)"
  },
  "domainRules": {
    "educationSystems": ["GENERAL", "EGYPTIAN_BACCALAUREATE"],
    "gradeLevels": ["PREP_1", "PREP_2", "PREP_3", "SEC_1", "SEC_2", "SEC_3"],
    "educationSystemAndGradeLevelIndependent": true,
    "languageTracks": ["ARABIC", "LANG_ENGLISH"],
    "groupFocusMathBranchOptional": true,
    "strictMathBranchAssignmentLevel": "Lesson / Question level (later phases)"
  },
  "sessionRules": {
    "occurrenceKeyFormat": "${scheduleId}_${scheduledDate}",
    "occurrenceKeyImmutable": true,
    "scheduledFieldsImmutable": ["scheduledDate", "scheduledStartTime"],
    "executionFieldsMutable": ["effectiveDate", "effectiveStartTime"],
    "statusEnum": ["SCHEDULED", "COMPLETED", "RESCHEDULED", "CANCELLED_BY_TEACHER"],
    "rollingHorizonCalendarDays": 28,
    "rollingHorizonDefinition": "today through today + 27 days inclusive",
    "rendererControlsHorizonLength": false,
    "rescheduledSessionSlotRecreationBlocked": true,
    "todayDashboardQueryField": "effectiveDate",
    "todayDashboardOrderField": "effectiveStartTime"
  },
  "paymentRules": {
    "groupDefaults": ["defaultPaymentType", "defaultPaymentAmount"],
    "studentHasPaymentOverrides": false,
    "enrollmentOverrides": ["paymentTypeOverride", "paymentAmountOverride"],
    "nullOverrideBehavior": "Inherits group defaults via calculateEffectivePayment()",
    "multiGroupPricingIndependence": true,
    "reEnrollmentHistoryPreserved": true,
    "activeEnrollmentConstraint": "Partial unique index on (groupId, studentId) WHERE status = 'ACTIVE'"
  },
  "authRules": {
    "pinLength": 4,
    "pinType": "Numeric digits only",
    "kdf": "crypto.scrypt",
    "scryptParams": {
      "N": 16384,
      "r": 8,
      "p": 1,
      "maxmem": 33554432,
      "keylen": 64,
      "saltBytes": 16
    },
    "verificationComparison": "crypto.timingSafeEqual",
    "maxFailedAttemptsBeforeLock": 5,
    "cooldownDurationSeconds": 30,
    "plaintextPinPersisted": false,
    "plaintextPinAudited": false
  },
  "backupRules": {
    "method": "better-sqlite3 native db.backup()",
    "systemDbIncluded": true,
    "allRegisteredAcademicYearsIncluded": true,
    "mediaIncluded": true,
    "integrityVerificationPragma": "PRAGMA integrity_check;",
    "rollingRetentionCount": 4,
    "rollingRetentionTrigger": "Newest 4 confirmed SUCCESS generations",
    "archivalBackupsPruned": false,
    "canonicalBackupRoot": "<appDataDir>/backups",
    "manualBackupPermission": "BACKUP_MANAGE",
    "automaticBackupActorType": "SYSTEM"
  },
  "designRules": {
    "brandConstants": {
      "primaryPetrolTeal": "#0B3D3D",
      "accentMutedGold": "#C59B27",
      "supportingTeal": "#1F6E68",
      "goldHover": "#B38728"
    },
    "brandConstantsIdenticalInDarkTheme": true,
    "darkModeSurfaces": {
      "app": "#0A1417",
      "surface": "#0F1F24",
      "elevated": "#162B32"
    },
    "pureBlackAllowedInDarkTheme": false,
    "typography": {
      "arabic": "Cairo (@fontsource/cairo)",
      "latinAndNumbers": "Inter (@fontsource/inter)",
      "mathematics": "local KaTeX fonts"
    },
    "remoteFontCdnAllowed": false,
    "officialLogoSha256": "66BFBEF03BE0E7EE99CDBE147C13859E92AC9071A9E8AC47F681EE30D0254749",
    "officialLogoImmutable": true,
    "defaultDirection": "rtl",
    "isolatedMathDirection": "ltr"
  },
  "aiRules": {
    "localAiModelAllowed": false,
    "noOfflineAiModelReason": "NO fully local/offline AI model will ever be added. Tibyan will never run Ollama, local Llama, or local LLMs on teacher hardware. Future AI will use external cloud APIs only (e.g. Gemini API).",
    "cloudAiInteractionModel": "Controlled @tibyan/core tool invocations only",
    "aiDirectSqlAccessAllowed": false,
    "sensitiveAiActionWorkflow": "Preview -> Confirm -> Execute -> Audit -> Undo"
  },
