{
  "name": "@tibyan/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate:system": "drizzle-kit generate --config=drizzle.system.config.ts",
    "db:generate:academic": "drizzle-kit generate --config=drizzle.academic.config.ts",
    "db:generate": "pnpm db:generate:system && pnpm db:generate:academic"
  },
  "dependencies": {
    "@tibyan/contracts": "workspace:*",
    "better-sqlite3": "12.11.1",
    "drizzle-orm": "^0.39.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "drizzle-kit": "^0.30.4",
    "typescript": "^5.7.3"
  }
}
