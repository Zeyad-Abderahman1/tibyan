{
  "name": "tibyan-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "تِبيان — مساعد المدرس الذكي (Teacher Operating System)",
  "scripts": {
    "dev": "pnpm --filter @tibyan/desktop dev",
    "build": "pnpm -r --filter=!tibyan-monorepo build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "rebuild:native": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
